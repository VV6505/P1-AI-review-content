# Copy thành .env rồi điền giá trị thật. KHÔNG commit file .env.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
# Provider OpenAI-compatible dự phòng cho M1/M2. Chỉ đặt ở BE, không đưa vào FE.
FREEMODEL_API_KEY=
FAL_KEY=

# --- Demo P1 local end-to-end (không dùng Supabase, không commit data/output) ---
# Bật cả API và runner trên cùng một máy. Chỉ dùng cho demo một người/đơn tiến trình.
# LOCAL_P1_MODE=1
# LOCAL_P1_DATA_DIR=./data/local-p1
# LOCAL_P1_AUTH_DIR=./data/local-p1/auth
# VIDEO_OUTPUT_DIR=./data/videos
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe
# edge = nhẹ, không cần API key riêng; gemini = dùng GEMINI_API_KEY ở trên.
# TTS_PROVIDER=edge
# TTS_VOICE=vi-VN-HoaiMyNeural
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# Crawl M1 (tuỳ chọn, mặc định bằng spike). Xem services/worker/README.md
# M1_CRAWL_MAX_PAGES=30
# M1_CRAWL_MIN_INTERVAL_S=1.0
# M1_CRAWL_USER_AGENT=
# M1_CRAWL_REGION=VN
# Ngôn ngữ trang được crawl, theo thứ tự ưu tiên (bản dịch trùng chỉ giữ bản đứng trước)
# M1_CRAWL_LANGUAGES=en,vi

# LLM M1/M2 mặc định dùng Gemini free tier cho pilot.
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-3.5-flash-lite
# FreeModel/OpenAI-compatible đang tạm ngưng; chỉ mở lại khi cần provider dự phòng:
# LLM_PROVIDER=freemodel
# LLM_MODEL=gpt-6.1-sol
# LLM_BASE_URL=https://freemodel.in/v1
# Giá quy đổi tùy model; để 0 khi chỉ đo pilot trong free allowance.
# LLM_INPUT_PRICE_PER_1M=0
# LLM_OUTPUT_PRICE_PER_1M=0
# LLM_MAX_OUTPUT_TOKENS=16384
# LLM_TIMEOUT_S=180
# LLM_RETRY_DELAYS_S=5,10,20,40,60
# LLM_FIXTURE_PATH=

# M2 sinh kịch bản. Tốc độ đọc giả định để tính estimated_duration_s (ước tính, không phải duration TTS/MP4)
# Giọng Edge/gTTS tiếng Việt local đo thực tế gần 2.9 từ/giây; dùng để M2 ước lượng sát hơn.
# M2_SYLLABLES_PER_S=2.9
# Short video linh hoạt theo nội dung, tối đa dưới 60s; TTS thật vẫn là số đo quyết định.
# M2_NARRATION_MIN_SYLLABLES=80
# M2_NARRATION_MAX_SYLLABLES=150

# --- API P1 (xem docs/specs/p1-secrets-and-quota.md). Chỉ để giá trị thật trong .env ---
SUPABASE_ANON_KEY=
# Token chung để n8n gọi endpoint dịch vụ (header X-Service-Token). Sinh: openssl rand -hex 32
N8N_SERVICE_TOKEN=
# Ảnh AI (Cloudflare Workers AI), tên chuẩn của nhà cung cấp
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Ngưỡng chi phí một job (USD). Trống = không chặn
# JOB_COST_LIMIT_USD=0.10
# WORKER_HTTP_TIMEOUT_S=15

# --- Bộ chạy job (python -m worker.runner) ---
# WORKER_PAGE_STORE_DIR=./data/pages
# RUNNER_POLL_INTERVAL_S=5
# RUNNER_MAX_ATTEMPTS=3
# RUNNER_RETRY_BACKOFF_S=30
